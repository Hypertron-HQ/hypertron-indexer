NODE_ENV=development
PORT=4002
CORS_ORIGINS=http://localhost:3000

# Atlas: use the dedicated hypertron_indexer database and service user.
DATABASE_URL=mongodb+srv://indexer_svc:<password>@<cluster>.mongodb.net/hypertron_indexer?retryWrites=true&w=majority

# Local Redis. On Render, use the private Valkey URL from the linked service.
REDIS_URL=redis://localhost:6379

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# This manifest is committed with the indexer so it exists in the Render build.
DEPLOYMENTS_PATH=./deployments/testnet.json

# First commit_inserted for the current testnet pool is ledger 4168763.
# Keep this close enough to the public RPC retention window to backfill index 0.
INDEXER_START_LEDGER=4168760

DISABLE_INGEST=false

# Optional. Leave empty on Render; verification falls back to stored
# rootAfter plus the commitment contract's root/size.
MERKLE_WASM_DIR=
