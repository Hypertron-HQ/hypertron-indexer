NODE_ENV=development
PORT=4002
CORS_ORIGINS=http://localhost:3000

# Atlas: indexer_svc user, DB hypertron_indexer — see ../scripts/atlas-mongo-users.md
DATABASE_URL=mongodb+srv://indexer_svc:<password>@<cluster>.mongodb.net/hypertron_indexer?retryWrites=true&w=majority

REDIS_URL=redis://localhost:6379

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Absolute or relative path to deployments JSON (never hardcode contract IDs in code)
DEPLOYMENTS_PATH=../hypertron-contracts/deployments/testnet.json

# After pool redeploy: set to the deploy ledger so ingest starts from tree genesis.
# Do not leave at 1 if the chain tip is far ahead and history has expired (~7 days).
INDEXER_START_LEDGER=1

DISABLE_INGEST=false

# Path to prover-wasm pkg/ (node/hypertron_prover.js exposes merkle_root)
# Build: bash ../hypertron-contracts/prover-wasm/build.sh
MERKLE_WASM_DIR=../hypertron-contracts/prover-wasm/pkg
